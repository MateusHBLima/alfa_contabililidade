{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planee-fiscal",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // A tela e a API saem no MESMO deploy. Arquivos de public/ são servidos direto;
  // o que não casar com arquivo cai no Worker (as rotas /api/* e o fallback de SPA).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planee-fiscal",
      // Placeholder com formato válido, de propósito: assim `npm run dev` roda offline,
      // com um SQLite local, sem conta na Cloudflare. Para publicar, rode
      // `npx wrangler d1 create planee-fiscal` e substitua pelo id de verdade —
      // o deploy com este valor falha na cara, dizendo que o banco não existe.
      "database_id": "d321662d-4ef3-4049-84f8-467488be426b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // Object Lock (compliance, 5 anos) precisa ser ativado pelo painel/API.
      // O bucket guarda o XML assinado do fornecedor: nunca sofre alteracao.
      "binding": "XML_ORIGINAL",
      "bucket_name": "planee-xml-original"
    },
    {
      "binding": "XML_TRABALHO",
      "bucket_name": "planee-xml-trabalho"
    }
  ],

  // O padrao e producao de proposito. O wrangler dev sobrescreve pelo .dev.vars,
  // que so existe na maquina de quem desenvolve. O contrario - padrao "dev" e
  // lembrar de trocar antes de publicar - depende de memoria humana, e um dia
  // alguem esquece e a producao se anuncia como ambiente de teste.
  "vars": {
    "AMBIENTE": "producao"
  }

  // Segredos (wrangler secret put):
  //   SESSION_SECRET  - assinatura do cookie de sessao
  //   AUDIT_SEED      - semente inicial da cadeia de hash da auditoria
}
